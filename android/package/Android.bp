package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "external_deqp_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["external_deqp_license"],
    default_team: "trendy_team_android_gpu",
}

android_library {
    name: "com.drawelements.deqp.java",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    resource_dirs: ["res"],
    sdk_version: "test_current",
    min_sdk_version: "31",
}

android_app {
    name: "com.drawelements.deqp.shell",
    static_libs: ["com.drawelements.deqp.java"],
    manifest: "AndroidManifest-integration.xml",
    sdk_version: "test_current",
}

android_robolectric_test {
    name: "DeqpAppTests",
    srcs: ["tests/**/*.java"],
    static_libs: [
        "com.drawelements.deqp.java",
        "androidx.test.core",
        "androidx.test.ext.junit",
        "truth",
        "Robolectric_all-target",
        "easymock",
    ],
    associates: ["com.drawelements.deqp.java"],
    instrumentation_for: "com.drawelements.deqp.shell",
    test_suites: ["general-tests"],
    upstream: true,
}
